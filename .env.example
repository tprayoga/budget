# Postgres
POSTGRES_USER=indotek
POSTGRES_PASSWORD=indotek
POSTGRES_DB=indotek_budget
DATABASE_URL=postgresql://indotek:indotek@localhost:5432/indotek_budget?schema=public
# Database khusus test API (dibuat otomatis oleh skrip test)
TEST_DATABASE_URL=postgresql://indotek:indotek@localhost:5432/indotek_budget_test?schema=public

# API
API_PORT=3000
JWT_ACCESS_SECRET=ganti-dengan-string-acak-panjang
JWT_REFRESH_SECRET=ganti-dengan-string-acak-panjang-lain
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
UPLOAD_DIR=./storage/uploads
CORS_ORIGIN=http://localhost:5173
# Kosongkan untuk memakai Chrome bawaan puppeteer; di Docker diisi /usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=

# Seed
SEED_PASSWORD=Indotek123!

# Web
VITE_API_URL=/api

# Cookie auth: Secure=true (default). Set false HANYA bila diakses via HTTP non-localhost (dev/test).
COOKIE_SECURE=true
# Rate limit login per IP+email
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MS=60000
# Production (NODE_ENV=production): user demo tidak dibuat; admin awal dari variabel ini
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
