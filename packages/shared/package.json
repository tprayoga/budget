{
  "name": "@indotek/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./xlsx": {
      "import": {
        "types": "./dist/xlsx.d.ts",
        "default": "./dist/xlsx.js"
      },
      "require": {
        "types": "./dist/xlsx.d.cts",
        "default": "./dist/xlsx.cjs"
      }
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts src/xlsx.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/xlsx.ts --format cjs,esm --dts --watch",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "exceljs": "^4.4.0",
    "tsup": "^8.3.5",
    "vitest": "2.1.9",
    "@types/node": "^22.10.0"
  },
  "peerDependencies": {
    "exceljs": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      "xlsx": [
        "./dist/xlsx.d.ts"
      ]
    }
  }
}
