// Indotek Project Budget System — Fase 1
// Uang: Decimal(18,2). Rasio/persen: Decimal(16,12) (0.025 = 2,5%) — cukup presisi agar konversi Rp→% tidak menggeser rupiah.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PM
  FINANCE
  DIREKTUR
  INVESTOR
}

enum ClusterStatus {
  PLAN
  ONGOING
  DONE
  CANCELLED
}

enum Division {
  IBK
  TELCO
}

enum LineMode {
  PCT
  RP
}

/// Kode baris budget (BudgetLine & template).
enum BudgetCode {
  SUBCON
  TICKET
  INDIRECT
  DIRECT
  OPS_KANTOR
  MOTOR_MOBIL
  HOMEBASE
  ALLOWANCE
  MARKETING
}

/// Pos form pengajuan dana (Bagian A + B).
enum FrCode {
  SUBCON
  PERMIT
  TICKET
  PAJAK
  INDIRECT
  DIRECT
  OPS_KANTOR
  MOTOR_MOBIL
  HOMEBASE
  ALLOWANCE
  MARKETING
}

enum FrStatus {
  DRAFT
  DIAJUKAN
  DIPERIKSA_FINANCE
  DISETUJUI_DIREKTUR
  DIKETAHUI_INVESTOR
  DICAIRKAN
  DITOLAK
}

enum ApprovalStep {
  DIAJUKAN
  PERIKSA_FINANCE
  SETUJU_DIREKTUR
  MENGETAHUI_INVESTOR
  PENCAIRAN
}

enum ApprovalAction {
  APPROVE
  REJECT
}

enum AttachmentKind {
  PROYEKSI_BUDGET
  PO_SPK
  RENCANA_KERJA
  BOQ_PENAWARAN
  LAPORAN_TERMIN_SEBELUMNYA
  LAINNYA
  BUKTI_CAIR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  jabatan      String?
  active       Boolean  @default(true)
  /// Wajib ganti password saat login berikutnya (default untuk user baru & user demo)
  mustChangePassword Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   ProjectMember[]
  refreshTokens RefreshToken[]
  fundRequests  FundRequest[]   @relation("DiajukanOleh")
  overrides     FundRequest[]   @relation("OverrideOleh")
  approvals     Approval[]
  auditLogs     AuditLog[]
  attachments   Attachment[]
  expensesCreated  Expense[]      @relation("ExpenseCreatedBy")
  expensesVerified Expense[]      @relation("ExpenseVerifiedBy")
  apiKeys          ApiKey[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Client {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  projects  Project[]
  terminTemplates TerminTemplate[]
}

model Project {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  clientId  String
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client       Client          @relation(fields: [clientId], references: [id])
  clusters     Cluster[]
  setting      Setting?
  template     BudgetTemplate?
  members      ProjectMember[]
  fpdSequences FpdSequence[]
  expenses     Expense[]
  categoryMappings CategoryMapping[]
  cashLedger   CashLedger[]
}

/// Akses project per user. Dipakai untuk membatasi role INVESTOR.
model ProjectMember {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

/// projectId null = setting global (satu baris). Kolom null pada setting project = ikut global.
model Setting {
  id            String   @id @default(cuid())
  projectId     String?  @unique
  interestRate  Decimal? @db.Decimal(16, 12)
  retensiAsCost Boolean?
  rekeningBank  String?
  rekeningNo    String?
  rekeningNama  String?
  /// Ambang kuning realisasi (% terpakai), mis. 0.8 = 80%
  realisasiWarnPct Decimal? @db.Decimal(16, 12)
  /// Ambang notifikasi over budget (rasio, 1 = 100%)
  realisasiOverPct Decimal? @db.Decimal(16, 12)
  updatedAt     DateTime @updatedAt
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Template default saat membuat cluster baru. projectId null = global; template project meng-override per pos.
model BudgetTemplate {
  id          String               @id @default(cuid())
  projectId   String?              @unique
  pajakRate   Decimal?             @db.Decimal(16, 12)
  retensiRate Decimal?             @db.Decimal(16, 12)
  updatedAt   DateTime             @updatedAt
  project     Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lines       BudgetTemplateLine[]
}

model BudgetTemplateLine {
  id         String         @id @default(cuid())
  templateId String
  code       BudgetCode
  mode       LineMode       @default(PCT)
  pct        Decimal?       @db.Decimal(16, 12)
  amount     Decimal?       @db.Decimal(18, 2)
  template   BudgetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, code])
}

model Cluster {
  id            String        @id @default(cuid())
  projectId     String
  name          String
  info          String?
  division      Division?
  status        ClusterStatus @default(PLAN)
  nilaiPoImpl   Decimal       @db.Decimal(18, 2)
  nilaiPoPermit Decimal       @default(0) @db.Decimal(18, 2)
  permitCost    Decimal       @default(0) @db.Decimal(18, 2)
  pajakRate     Decimal       @db.Decimal(16, 12)
  retensiRate   Decimal       @default(0.10) @db.Decimal(16, 12)
  /// Tanggal mulai implementasi (dari info "Implementasi: dd/mm/yyyy" atau diinput)
  implementationDate DateTime? @db.Date
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project      Project       @relation(fields: [projectId], references: [id])
  budgetLines  BudgetLine[]
  fundRequests FundRequest[]
  expenses     Expense[]
  allocations  ExpenseAllocation[]
  clientPayments ClientPayment[]
  pos          ClusterPo[]
  invoiceRefs  ClientInvoiceRef[]

  @@unique([projectId, name])
  @@index([projectId])
}

model BudgetLine {
  id        String     @id @default(cuid())
  clusterId String
  code      BudgetCode
  label     String
  mode      LineMode
  pct       Decimal?   @db.Decimal(16, 12)
  amount    Decimal?   @db.Decimal(18, 2)
  sortOrder Int
  cluster   Cluster    @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([clusterId, code])
}

/// Nomor urut FPD per project per bulan (dikunci & dinaikkan di dalam transaksi submit).
model FpdSequence {
  projectId String
  year      Int
  month     Int
  lastSeq   Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, year, month])
}

model FundRequest {
  id             String   @id @default(cuid())
  /// Nomor FPD; null selama belum pernah disubmit (tampil sebagai DRAFT-xxxxxx).
  number         String?  @unique
  clusterId      String
  terminKe       Int
  tanggal        DateTime @db.Date
  periode        String?
  diajukanOlehId String
  diajukanKepada String   @default("Investor")
  justifikasi    String
  rekeningBank   String?
  rekeningNo     String?
  rekeningNama   String?
  status         FrStatus @default(DRAFT)

  // Snapshot (dibekukan saat SUBMIT; selama DRAFT ikut budget/setting terkini)
  nilaiProyek   Decimal @db.Decimal(18, 2)
  interestRate  Decimal @db.Decimal(16, 12)
  retensiAsCost Boolean
  infoBunga     Decimal @db.Decimal(18, 2)
  infoRetensi   Decimal @db.Decimal(18, 2)
  infoProfit    Decimal @db.Decimal(18, 2)
  infoMargin    Decimal @db.Decimal(16, 12)
  totalDiajukan Decimal @db.Decimal(18, 2)

  submittedAt           DateTime?
  cairTanggal           DateTime? @db.Date
  cairBuktiAttachmentId String?   @unique
  overrideReason        String?
  overrideById          String?
  rejectedNote          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  cluster      Cluster           @relation(fields: [clusterId], references: [id])
  diajukanOleh User              @relation("DiajukanOleh", fields: [diajukanOlehId], references: [id])
  overrideBy   User?             @relation("OverrideOleh", fields: [overrideById], references: [id])
  lines        FundRequestLine[]
  approvals    Approval[]
  attachments  Attachment[]      @relation("FrAttachments")
  cairBukti    Attachment?       @relation("CairBukti", fields: [cairBuktiAttachmentId], references: [id])
  expenses     Expense[]

  @@index([clusterId, status])
  @@index([status])
}

model FundRequestLine {
  id                    String      @id @default(cuid())
  fundRequestId         String
  budgetCode            FrCode
  label                 String
  budgetAmount          Decimal     @db.Decimal(18, 2)
  pctNilaiProyek        Decimal     @db.Decimal(16, 12)
  pctCair               Decimal     @default(1) @db.Decimal(16, 12)
  diajukan              Decimal     @db.Decimal(18, 2)
  sudahDicairkanSebelum Decimal     @default(0) @db.Decimal(18, 2)
  sedangDiproses        Decimal     @default(0) @db.Decimal(18, 2)
  sisaBudget            Decimal     @db.Decimal(18, 2)
  keterangan            String?
  sortOrder             Int
  fundRequest           FundRequest @relation(fields: [fundRequestId], references: [id], onDelete: Cascade)

  @@unique([fundRequestId, budgetCode])
}

model Approval {
  id            String         @id @default(cuid())
  fundRequestId String
  step          ApprovalStep
  userId        String
  action        ApprovalAction
  note          String?
  at            DateTime       @default(now())
  fundRequest   FundRequest    @relation(fields: [fundRequestId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id])

  @@index([fundRequestId])
}

/// Lampiran form. fileUrl boleh kosong: lampiran bisa hanya dicentang (diserahkan fisik) seperti form Excel.
model Attachment {
  id             String         @id @default(cuid())
  fundRequestId  String
  kind           AttachmentKind
  label          String?
  fileUrl        String?
  fileName       String?
  mimeType       String?
  size           Int?
  checked        Boolean        @default(false)
  uploadedById   String?
  createdAt      DateTime       @default(now())
  fundRequest    FundRequest    @relation("FrAttachments", fields: [fundRequestId], references: [id], onDelete: Cascade)
  uploadedBy     User?          @relation(fields: [uploadedById], references: [id])
  cairBuktiOf    FundRequest?   @relation("CairBukti")

  @@index([fundRequestId])
}

model AuditLog {
  id       String   @id @default(cuid())
  entity   String
  entityId String
  field    String
  oldValue String?
  newValue String?
  userId   String?
  at       DateTime @default(now())
  user     User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([at])
}

// =====================================================================================
// Fase 2 — Realisasi biaya vs budget
// =====================================================================================

enum ExpenseCategory {
  SUBCON_JASA
  SUBCON_MATERIAL
  PERMIT
  OPS
  PJD
  TICKET
  HOMEBASE
  MOTOR_MOBIL
  MATERIAL_PEMBELIAN
  PAJAK
  MARKETING_FEE
  LAINNYA
}

enum ExpenseStatus {
  PERLU_VERIFIKASI
  TERVERIFIKASI
  DITOLAK
}

enum ExpenseSource {
  MANUAL
  MOBILE
  WEBHOOK
  IMPORT_RAB
  CLIENT_PAYMENT
}

enum AllocationMethod {
  EQUAL
  PRO_RATA_PO
  MANUAL
}

/// Jenis termin klien = jenis PO sumbernya (template hanya untuk IMPLEMENTASI & PERMIT).
enum TerminKind {
  IMPLEMENTASI
  PERMIT
  SND
  ADDWORK
  DEDUCTION
}

enum PoKind {
  IMPLEMENTASI
  PERMIT
  SND
  ADDWORK
  DEDUCTION
}

enum AgingType {
  CALENDAR
  WORKING
}

enum ClientPaymentStatus {
  UNBILLED
  INVOICED
  PAID
}

/// Realisasi biaya. clusterId null = biaya level project yang dialokasikan ke beberapa cluster.
/// Laporan per cluster SELALU membaca ExpenseAllocation (expense level cluster = 1 alokasi 100%).
model Expense {
  id               String            @id @default(cuid())
  projectId        String
  clusterId        String?
  /// null hanya untuk data import yang tanggalnya tidak ada di sheet
  date             DateTime?         @db.Date
  periodLabel      String?
  category         ExpenseCategory
  budgetCode       FrCode
  description      String
  amount           Decimal           @db.Decimal(18, 2)
  termin           String?
  vendor           String?
  invoiceNo        String?
  attachmentUrl    String?
  attachmentName   String?
  attachmentMime   String?
  fundRequestId    String?
  status           ExpenseStatus
  source           ExpenseSource
  /// Kunci idempotensi: RAB:{sheet}!{sel}, WEBHOOK:{key}:{externalId}, CLIENT_PAYMENT:{paymentId}
  sourceRef        String?           @unique
  allocationMethod AllocationMethod?
  rejectNote       String?
  /// Catatan khusus (mis. "kasbon — perlu penyelesaian")
  note             String?
  createdById      String?
  apiKeyId         String?
  verifiedById     String?
  verifiedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  project     Project             @relation(fields: [projectId], references: [id])
  cluster     Cluster?            @relation(fields: [clusterId], references: [id])
  fundRequest FundRequest?        @relation(fields: [fundRequestId], references: [id])
  createdBy   User?               @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  verifiedBy  User?               @relation("ExpenseVerifiedBy", fields: [verifiedById], references: [id])
  apiKey      ApiKey?             @relation(fields: [apiKeyId], references: [id])
  allocations ExpenseAllocation[]

  @@index([projectId, status])
  @@index([clusterId])
  @@index([fundRequestId])
}

model ExpenseAllocation {
  id        String  @id @default(cuid())
  expenseId String
  clusterId String
  amount    Decimal @db.Decimal(18, 2)
  pct       Decimal @db.Decimal(16, 12)
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  cluster   Cluster @relation(fields: [clusterId], references: [id])

  @@unique([expenseId, clusterId])
  @@index([clusterId])
}

/// Mapping default kategori → pos budget. projectId null = global; mapping project meng-override.
model CategoryMapping {
  id         String          @id @default(cuid())
  projectId  String?
  category   ExpenseCategory
  /// null = wajib dipilih manual saat input (mis. LAINNYA)
  budgetCode FrCode?
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, category])
}

model TerminTemplate {
  id        String               @id @default(cuid())
  clientId  String
  kind      TerminKind
  agingDays Int?
  agingType AgingType?
  updatedAt DateTime             @updatedAt
  client    Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lines     TerminTemplateLine[]

  @@unique([clientId, kind])
}

model TerminTemplateLine {
  id         String         @id @default(cuid())
  templateId String
  terminKe   Int
  pct        Decimal        @db.Decimal(16, 12)
  keterangan String?
  template   TerminTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, terminKe])
}

/// Termin pembayaran klien per cluster. amount = bruto; paidAmount = yang benar-benar diterima.
model ClientPayment {
  id          String              @id @default(cuid())
  clusterId   String
  /// PO sumber termin (termin digenerate per PO)
  poId        String?
  /// false = termin manual (tanpa template) → tanggal invoice perlu dilengkapi
  fromTemplate Boolean            @default(true)
  kind        TerminKind
  termin      Int
  pct         Decimal?            @db.Decimal(16, 12)
  amount      Decimal             @db.Decimal(18, 2)
  keterangan  String?
  invoiceNo   String?
  invoiceDate DateTime?           @db.Date
  dueDate     DateTime?           @db.Date
  paidDate    DateTime?           @db.Date
  paidAmount  Decimal?            @db.Decimal(18, 2)
  status      ClientPaymentStatus @default(UNBILLED)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  cluster     Cluster             @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  po          ClusterPo?          @relation(fields: [poId], references: [id], onDelete: Cascade)
  invoiceRefs ClientInvoiceRef[]

  @@unique([poId, termin])
  @@index([clusterId, kind])
}

model HariLibur {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date
  name String
}

/// Buku kas (sheet TELCO - OPS). Hanya referensi/rekonsiliasi — tidak dihitung sebagai realisasi.
model CashLedger {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  description  String
  projectId    String?
  projectLabel String?
  cashAccount  String?
  accountName  String?
  cashIn       Decimal  @default(0) @db.Decimal(18, 2)
  cashOut      Decimal  @default(0) @db.Decimal(18, 2)
  sourceKey    String   @unique
  sourceSheet  String?
  sourceRow    Int?
  importedAt   DateTime @default(now())
  project      Project? @relation(fields: [projectId], references: [id])

  @@index([projectId, date])
}

/// API key untuk webhook (bot Telegram/n8n). Key disimpan sebagai hash SHA-256; ditampilkan sekali saat dibuat.
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String
  keyHash     String    @unique
  scopes      String[]
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  createdBy   User      @relation(fields: [createdById], references: [id])
  expenses    Expense[]
}

/// Keputusan pemetaan manual saat import RAB, diingat untuk import berikutnya.
model ImportMappingRule {
  id          String            @id @default(cuid())
  sourceKey   String            @unique
  projectId   String
  /// CLUSTER | PROJECT | SKIP | INHERIT | HOLD | DUPLICATE
  scope       String
  clusterId   String?
  clusterIds  String[]
  method      AllocationMethod?
  /// [{ clusterId, pct }] untuk method MANUAL
  manualPcts  Json?
  /// Filter penerima dinamis: IMPL_DATE_LE_EXPENSE = cluster dengan tanggal implementasi ≤ tanggal expense (kosong ikut)
  clusterFilter String?
  category    ExpenseCategory?
  note        String?
  createdById String?
  updatedAt   DateTime          @updatedAt
}

/// Item import RAB yang ditahan (perlu konfirmasi). Datanya disimpan agar bisa dilepas tanpa import ulang.
model ImportHeldItem {
  id                String           @id @default(cuid())
  sourceRef         String           @unique
  projectId         String
  sheet             String
  cell              String
  section           String
  blockTitle        String?
  groupTitle        String?
  label             String
  date              DateTime?        @db.Date
  periodLabel       String?
  amount            Decimal          @db.Decimal(18, 2)
  suggestedCategory ExpenseCategory?
  /// Usulan tujuan (JSON RabTarget) untuk form pelepasan
  suggestedTarget   Json?
  /// EXPENSE (bisa dilepas jadi realisasi) | REVENUE (pendapatan/PO — tindak lanjut manual)
  kind              String           @default("EXPENSE")
  /// HELD | RELEASED | DISMISSED
  status            String           @default("HELD")
  /// untuk DISMISSED: DUPLICATE | SKIP
  resolution        String?
  note              String?
  expenseId         String?
  resolvedById      String?
  resolvedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([projectId, status])
}

/// Patch data/keputusan yang dijalankan sekali (idempotent), mis. keputusan review import.
model DataPatch {
  id        String   @id @default(cuid())
  name      String   @unique
  note      String?
  appliedAt DateTime @default(now())
}

// =====================================================================================
// Fase 2.3 — PO per cluster, proteksi import, notifikasi, referensi tagihan
// =====================================================================================

/// PO per cluster. nilaiPoImpl = Σ IMPLEMENTASI + ADDWORK + DEDUCTION; nilaiPoPermit = Σ PERMIT + SND;
/// permitCost = Σ passThroughCost. Ketiga kolom di Cluster menjadi nilai turunan (cache) dari tabel ini.
model ClusterPo {
  id              String          @id @default(cuid())
  clusterId       String
  kind            PoKind
  poNumber        String?
  poDate          DateTime?       @db.Date
  /// DEDUCTION bernilai negatif
  amount          Decimal         @db.Decimal(18, 2)
  passThroughCost Decimal         @default(0) @db.Decimal(18, 2)
  note            String?
  /// Kunci idempotensi import (mis. RAB:ADW!AL10#1, MIGRASI:{clusterId}:IMPLEMENTASI)
  sourceRef       String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  cluster         Cluster         @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  termins         ClientPayment[]

  @@index([clusterId])
}

/// Field yang diubah lewat aplikasi (dilindungi dari import budget Excel).
model FieldOverride {
  id       String   @id @default(cuid())
  entity   String
  entityId String
  /// mis. nilaiPoImpl, pajakRate, line.SUBCON.amount
  field    String
  userId   String?
  reason   String?
  at       DateTime @default(now())

  @@unique([entity, entityId, field])
}

/// Notifikasi in-app (mis. pos/cluster melewati ambang budget). `key` mencegah notifikasi ganda.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  key       String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, key])
  @@index([userId, readAt])
}

/// Referensi tagihan klien dari file RAB (no. invoice, nilai net, jatuh tempo, Paid/Unpaid). Tidak diterapkan otomatis.
model ClientInvoiceRef {
  id              String         @id @default(cuid())
  sourceRef       String         @unique
  projectId       String
  clusterId       String?
  blockTitle      String?
  termin          Int?
  invoiceNo       String
  netAmount       Decimal?       @db.Decimal(18, 2)
  dueDate         DateTime?      @db.Date
  statusText      String?
  paid            Boolean        @default(false)
  appliedPaymentId String?
  appliedAt       DateTime?
  appliedById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  cluster         Cluster?       @relation(fields: [clusterId], references: [id])
  appliedPayment  ClientPayment? @relation(fields: [appliedPaymentId], references: [id])

  @@index([projectId])
}
