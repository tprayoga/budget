{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-scripts",
    "rootDir": ".",
    "noEmit": false,
    "incremental": false,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["prisma/seed.ts", "scripts/create-users.ts", "scripts/reset-password.ts", "scripts/rekap-snapshot.ts", "scripts/migration-cleanup.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-scripts", "test", "**/*.spec.ts"]
}
