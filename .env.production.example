# =====================================================================================================
#  Indotek Budget — konfigurasi PRODUCTION. Salin jadi .env.production (JANGAN di-commit; chmod 600).
#  Cara cepat: ./scripts/gen-secrets.sh {{DOMAIN}} {{EMAIL_ADMIN}} {{GHCR_OWNER}}
#  → semua nilai bertanda <ACAK> diisi otomatis dengan openssl rand. Nilai lain isi manual.
# =====================================================================================================

# --- Domain & HTTPS ------------------------------------------------------------------------------------
# Domain publik aplikasi (A record → IP VPS). Caddy mengambil sertifikat Let's Encrypt otomatis.
DOMAIN={{DOMAIN}}
# Email untuk Let's Encrypt (notifikasi kedaluwarsa sertifikat)
ACME_EMAIL={{EMAIL_ADMIN}}
# Opsional saat uji coba pertama (hindari limit Let's Encrypt): https://acme-staging-v02.api.letsencrypt.org/directory
# ACME_CA=
HTTP_PORT=80
HTTPS_PORT=443

# --- Image (GHCR) -----------------------------------------------------------------------------------------
API_IMAGE=ghcr.io/{{GHCR_OWNER}}/indotek-api
WEB_IMAGE=ghcr.io/{{GHCR_OWNER}}/indotek-web
BACKUP_IMAGE=ghcr.io/{{GHCR_OWNER}}/indotek-backup
# Diisi deploy.sh (git sha pendek). Jangan diedit manual.
TAG=latest

# --- Database (hanya network internal Docker, tidak di-expose) -------------------------------------------------
POSTGRES_USER=indotek
POSTGRES_DB=indotek_budget
POSTGRES_PASSWORD=<ACAK>

# --- Redis (rate limit login/webhook & lock pemindaian; internal) ----------------------------------------------
REDIS_PASSWORD=<ACAK>

# --- Secret aplikasi (min. 32 karakter; API menolak start bila lemah) --------------------------------------
# Rotasi JWT_* → semua user logout (refresh token tidak valid). Rotasi COOKIE_SECRET → token CSRF lama tidak
# valid, semua user harus login ulang.
JWT_ACCESS_SECRET=<ACAK>
JWT_REFRESH_SECRET=<ACAK>
COOKIE_SECRET=<ACAK>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# --- Admin awal (dibuat seed sekali bila email belum ada; wajib ganti password saat login pertama) ----------
ADMIN_EMAIL={{EMAIL_ADMIN}}
ADMIN_PASSWORD=<ACAK>

# --- Batas & keamanan ----------------------------------------------------------------------------------
# Upload lampiran/foto nota (MB); MIME dicek dari isi file
UPLOAD_MAX_MB=10
# Login: maks percobaan per IP+email per jendela waktu
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MS=60000
# Webhook bot: maks kiriman per API key per jendela waktu
WEBHOOK_RATE_LIMIT=60
WEBHOOK_RATE_WINDOW_MS=60000
# info|warn|error|debug — log JSON ke stdout (docker logs)
LOG_LEVEL=info
# true hanya untuk uji multi-replika (header X-Instance & instance di /api/health)
EXPOSE_INSTANCE=false
# Swagger /api/docs dimatikan di production; true untuk mengaktifkan sementara
SWAGGER=false
API_MEM_LIMIT=1536m

# --- Backup (restic → object storage S3-compatible) ------------------------------------------------------------
# Bucket PRIVATE; access key KHUSUS backup dengan hak minimal (list/get/put/delete pada bucket ini saja).
S3_ENDPOINT={{S3_ENDPOINT}}
S3_BUCKET={{S3_BUCKET}}
S3_REGION={{S3_REGION}}
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Repository restic (gen-secrets.sh mengisi dari tiga nilai di atas)
RESTIC_REPOSITORY=s3:{{S3_ENDPOINT}}/{{S3_BUCKET}}/indotek-budget
# Kunci enkripsi backup — SIMPAN JUGA DI PASSWORD MANAGER. Tanpa ini backup tidak bisa dibuka.
RESTIC_PASSWORD=<ACAK>
# Jadwal (zona Asia/Jakarta)
BACKUP_CRON=0 2 * * *

# --- Hanya stack UJI lokal — JANGAN di server ------------------------------------------------------------------
# ALLOW_DEMO_SEED=true
# SEED_PASSWORD=
