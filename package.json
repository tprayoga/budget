{
  "name": "indotek-budget",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @indotek/shared build && pnpm --filter @indotek/api build && playwright test -c e2e/playwright.config.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.48.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "turbo": "^2.5.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.20.0"
  }
}
